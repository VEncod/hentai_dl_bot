# ─────────────────────────────────────────────────────────────────
# Hentai DL Bot — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# Telegram API credentials (get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Bot token (get from @BotFather on Telegram)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/

# (Optional) Pyrogram session string for userbot features
SESSION_STRING=

# NOTE: Log channel and archive channel are configured via bot commands:
#   /setlog <channel_id>       — Set the log channel
#   /setchannel <channel_id>   — Set the main archive channel
# The first user to /start the bot becomes the owner (super admin).
